{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Godot Hub",
  "version": "0.4.0",
  "identifier": "com.godothub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Godot Hub",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#10131a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:1420 ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "publisher": "Godot Hub",
    "shortDescription": "Manage Godot Engine installations on Windows",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMkZDNUY0MjE0Nzk0QTYKUldTbWxFY2g5TVV2bmoxMFRmZjRVMzZDWXQ4Lzk5dUhYUUZ4dVVUMzZ4bnFYWjhUSHNaaXE2cUUK",
      "endpoints": ["https://github.com/XuanKio/GodotHub/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
